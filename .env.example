# ==============================
# Postgres (docker-compose)
# ==============================
POSTGRES_USER=pkmn
POSTGRES_PASSWORD=pkmn
POSTGRES_DB=pkmn_dev
POSTGRES_PORT=5432

# ==============================
# Redis (docker-compose)
# ==============================
REDIS_PORT=6379

# ==============================
# API (NestJS) - apps/api
# ==============================
NODE_ENV=development
API_PORT=3333
DATABASE_URL=postgresql://pkmn:pkmn@localhost:5432/pkmn_dev?schema=public
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-in-production-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Logs
LOG_LEVEL=debug

# ==============================
# Worker - apps/worker
# ==============================

# TCGdex (catalogo - open source, sem chave)
TCGDEX_API_URL=https://api.tcgdex.net/v2
TCGDEX_LANGUAGE=en
TCGDEX_REQUEST_DELAY_MS=50

# Pokemon TCG API (precos - transitorio, sem chave, ate mar/2027)
# ATENCAO: pokemontcg.io descontinuada em 01/03/2027
# Migrar para PokeWallet/JustTCG/Scrydex antes desta data.
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2
POKEMON_TCG_REQUEST_DELAY_MS=2100

# Limite de cartas por execucao do snapshot de precos
# Sem chave: 1000 req/dia. Reservamos 100 para retries.
SNAPSHOT_MAX_CARDS=900

# Exchange rates (AwesomeAPI - sem chave)
EXCHANGE_RATES_API_URL=https://economia.awesomeapi.com.br/json

# Crons (formato cron: min hour day month dow)
CRON_SYNC_CATALOG="0 3 * * 0"
CRON_SNAPSHOT_PRICES="0 4 * * *"
CRON_EXCHANGE_RATES="0 5 * * *"

# ==============================
# Mobile (Expo) - apps/mobile
# ==============================
# Prefixo EXPO_PUBLIC_ e obrigatorio para expor ao runtime do RN
EXPO_PUBLIC_API_URL=http://localhost:3333
