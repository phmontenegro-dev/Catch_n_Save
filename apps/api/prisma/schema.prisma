// Prisma schema — Carteira Pokémon TCG
// Convenção: colunas em snake_case no DB, campos em camelCase no TS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================
// Usuários e autenticação
// ==============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  userCards     UserCard[]
  wishlists     Wishlist[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ==============================================================
// Catálogo (espelho da Pokémon TCG API)
// ==============================================================

model Set {
  id                String    @id
  name              String
  series            String
  ptcgoCode         String?   @map("ptcgo_code")
  printedTotal      Int       @map("printed_total")
  total             Int
  releaseDate       DateTime  @map("release_date")
  symbolUrl         String?   @map("symbol_url")
  logoUrl           String?   @map("logo_url")
  legalities        Json?
  externalUpdatedAt DateTime? @map("external_updated_at")
  syncedAt          DateTime  @default(now()) @map("synced_at")

  cards Card[]

  @@index([releaseDate])
  @@map("sets")
}

model Card {
  id                     String    @id
  setId                  String    @map("set_id")
  name                   String
  number                 String
  supertype              String
  subtypes               String[]
  rarity                 String?
  artist                 String?
  hp                     String?
  types                  String[]
  regulationMark         String?   @map("regulation_mark")
  nationalPokedexNumbers Int[]     @map("national_pokedex_numbers")
  legalities             Json?
  imageSmallUrl          String?   @map("image_small_url")
  imageLargeUrl          String?   @map("image_large_url")
  rawJson                Json      @map("raw_json")
  externalUpdatedAt      DateTime? @map("external_updated_at")
  syncedAt               DateTime  @default(now()) @map("synced_at")

  set          Set            @relation(fields: [setId], references: [id])
  userCards    UserCard[]
  wishlists    Wishlist[]
  prices       CardPrice[]
  priceHistory PriceHistory[]

  @@index([setId])
  @@index([name])
  @@index([rarity])
  @@map("cards")
}

// ==============================================================
// Coleção do usuário
// ==============================================================

enum CardCondition {
  NM
  LP
  MP
  HP
  DMG
}

model UserCard {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  cardId           String        @map("card_id")
  variant          String
  quantity         Int
  condition        CardCondition
  purchasePrice    Decimal?      @map("purchase_price")    @db.Decimal(12, 2)
  purchaseCurrency String?       @map("purchase_currency")
  purchaseDate     DateTime?     @map("purchase_date")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id])

  @@index([userId])
  @@index([userId, cardId])
  @@map("user_cards")
}

// ==============================================================
// Preços
// ==============================================================

enum PriceSource {
  TCGPLAYER
  CARDMARKET
}

// Snapshot mais recente por (card, source, variant) — leitura rápida
model CardPrice {
  id         String      @id @default(cuid())
  cardId     String      @map("card_id")
  source     PriceSource
  variant    String
  currency   String
  price      Decimal     @db.Decimal(12, 4)
  capturedAt DateTime    @map("captured_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  card Card @relation(fields: [cardId], references: [id])

  @@unique([cardId, source, variant])
  @@index([capturedAt])
  @@map("card_prices")
}

// Série histórica — append-only
model PriceHistory {
  id         BigInt      @id @default(autoincrement())
  cardId     String      @map("card_id")
  source     PriceSource
  variant    String
  currency   String
  price      Decimal     @db.Decimal(12, 4)
  recordedAt DateTime    @map("recorded_at")

  card Card @relation(fields: [cardId], references: [id])

  @@index([cardId, recordedAt])
  @@index([recordedAt])
  @@map("price_history")
}

// ==============================================================
// Câmbio (USD/EUR → BRL)
// ==============================================================

model ExchangeRate {
  id           BigInt   @id @default(autoincrement())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(18, 8)
  capturedAt   DateTime @map("captured_at")

  @@index([fromCurrency, toCurrency, capturedAt])
  @@map("exchange_rates")
}

// ==============================================================
// Wishlist
// ==============================================================

model Wishlist {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  cardId      String   @map("card_id")
  targetPrice Decimal? @map("target_price") @db.Decimal(12, 2)
  currency    String   @default("BRL")
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
  @@index([userId])
  @@map("wishlists")
}
